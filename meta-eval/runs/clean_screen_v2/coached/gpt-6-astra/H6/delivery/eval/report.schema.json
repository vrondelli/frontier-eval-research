{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:numeric-export-eval:report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "started_at", "seed", "generated", "timeout_seconds", "suite_scope", "candidate_sha256", "counts", "score", "cases"],
  "properties": {
    "schema_version": {"const": "numeric-export-eval/report-v1"},
    "status": {"enum": ["pass", "fail"]},
    "started_at": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "generated": {"type": "integer", "minimum": 0},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "suite_scope": {"enum": ["full", "filtered"]},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirements", "expected_valid", "passed", "reason", "exit_code", "duration_seconds", "input_sha256", "output_sha256", "stdout", "stderr"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CLI", "STRUCTURE", "JSON", "EXACT", "OPERATIONS", "OUTPUT", "FAILURE"]}},
        "expected_valid": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "exit_code": {"type": ["integer", "null"]},
        "duration_seconds": {"type": "number", "minimum": 0},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "stdout": {"type": "string", "maxLength": 2000},
        "stderr": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
